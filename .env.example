# Root .env is used by docker compose.
# Local bootRun does not load this file automatically.

# API
APP_NAME=file-storage
APP_SECURITY_ENABLED=false
# Set when APP_SECURITY_ENABLED=true.
API_JWT_PUBLIC_KEY=
API_DOWNLOAD_TOKEN_SECRET=change_me

# Shared infra
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=9876
SPRING_DATASOURCE_DB=file_storage
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_ENABLED=true

APP_MINIO_ENABLED=true
MINIO_BUCKET=file-storage
# For compose.dev-infra this is usually http://minio.local:9000.
# For direct container-to-container access in compose.yaml, use http://min-io:9000.
MINIO_ENDPOINT=http://minio.local:9000
MINIO_REGION=eu-central-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Kafka topics and listeners
APP_KAFKA_TOPIC_FILE_UPLOADED=file.uploaded.v1
APP_KAFKA_TOPIC_FILE_UPLOADED_DLT=file.uploaded.v1-dlt
APP_KAFKA_TOPIC_FILE_UPLOADED_PARTITIONS=8
APP_KAFKA_TOPIC_FILE_UPLOADED_REPLICAS=1
APP_KAFKA_TOPIC_FILE_DELETED=file.deleted.v1
APP_KAFKA_TOPIC_FILE_DELETED_DLT=file.deleted.v1-dlt
APP_KAFKA_TOPIC_FILE_DELETED_PARTITIONS=8
APP_KAFKA_TOPIC_FILE_DELETED_REPLICAS=1
APP_KAFKA_LISTENER_GROUP_ID=1
APP_KAFKA_LISTENER_CONCURRENCY=8
APP_KAFKA_LISTENER_POLL_TIMEOUT_MS=3000
APP_KAFKA_RETRY_INTERVAL_MS=1000
APP_KAFKA_RETRY_MAX_ATTEMPTS=3

# Storage timings
STORAGE_TOKEN_TTL=1h
STORAGE_TOKEN_PRESIGN_TTL=1m
STORAGE_PRESIGN_GET_TTL=10m
STORAGE_PRESIGN_PUT_TTL=10m
STORAGE_MULTIPART_CREATE=10s
STORAGE_MULTIPART_COMPLETE=10s
STORAGE_MULTIPART_SESSION_TTL=5m

# CORS
APP_CORS_ACTUATOR_ENABLED=true
APP_CORS_ACTUATOR_PATH_PATTERN=/actuator/**
APP_CORS_ACTUATOR_ALLOWED_ORIGINS=*
APP_CORS_ACTUATOR_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ACTUATOR_ALLOWED_HEADERS=*
APP_CORS_ACTUATOR_MAX_AGE_SECONDS=3600
APP_CORS_ACTUATOR_ALLOW_CREDENTIALS=false

APP_CORS_INTERNAL_ENABLED=true
APP_CORS_INTERNAL_PATH_PATTERN=/**
APP_CORS_INTERNAL_ALLOWED_ORIGINS=*
APP_CORS_INTERNAL_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_INTERNAL_ALLOWED_HEADERS=*
APP_CORS_INTERNAL_MAX_AGE_SECONDS=3600
APP_CORS_INTERNAL_ALLOW_CREDENTIALS=false

# Optional comma-separated list overrides:
# APP_CORS_ACTUATOR_ALLOWED_ORIGIN_PATTERNS=https://*.example.com
# APP_CORS_ACTUATOR_EXPOSED_HEADERS=ETag,X-Request-Id
# APP_CORS_INTERNAL_ALLOWED_ORIGIN_PATTERNS=https://*.example.com
# APP_CORS_INTERNAL_EXPOSED_HEADERS=ETag,X-Request-Id

# Compose-only
MINIO_LICENSE_FILE=./secrets/minio/minio.license
